{
  "name": "mix4up",
  "version": "1.0.0",
  "description": "Mix4Up: tus vídeos y YouTube sin Shorts",
  "main": "main.js",
  "author": "luckicla",
  "homepage": "https://luckicla.github.io/mix4up/",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.luckicla.mix4up.desktop",
    "productName": "Mix4Up",
    "executableName": "Mix4Up",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["main.js", "preload.js", "login-preload.js", "splash.html", "package.json"],
    "extraResources": [
      { "from": "bin", "to": "core", "filter": ["mix4up-core.exe"] },
      { "from": "build/icon.ico", "to": "icon.ico" }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "legalTrademarks": "Mix4Up"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Mix4Up",
      "uninstallDisplayName": "Mix4Up",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Mix4Up-Instalador.${ext}",
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "include": "build/installer.nsh",
      "multiLanguageInstaller": true,
      "installerLanguages": ["es_ES", "en_US", "ca_ES"],
      "language": "3082",
      "displayLanguageSelector": false,
      "warningsAsErrors": false
    },
    "portable": { "artifactName": "Mix4Up-Portable.${ext}" },
    "copyright": "© 2026 luckicla",
    "afterPack": "build/afterPack.js",
    "publish": [
      { "provider": "generic", "url": "https://github.com/luckicla/mix4up/releases/download/mix4up-pc-latest/" }
    ]
  },
  "license": "SEE LICENSE IN ../LICENSE"
}
